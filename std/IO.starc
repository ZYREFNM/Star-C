module std/IO;

import {
    "std/strings"
}

func void printf(string fmt, string text) {
    var string to_string = "";
    if (strings::contains(fmt, "%s")) {
        to_string = to_string << text;
    }
    ccall function printf(fmt.lit, to_string.lit);
}

static func void printfln(string fmt, string text) {
    IO::printf(fmt << "\n", text);
}